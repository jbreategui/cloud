# Copiar a .env y ajustar valores reales. .env no se commitea (ver .gitignore).
SPRING_PROFILES_ACTIVE=prod

# IP privada del EC2 donde corre Postgres (ver docs/db/docker-compose.yml). Debe estar
# en la misma VPC que este EC2 para usar IP privada en vez de publica.
DB_HOST=10.0.x.x
DB_PORT=5432
DB_NAME=docs_bd
DB_USERNAME=docs
DB_PASSWORD=admin

# Puerto expuesto al host por nginx (unico punto de entrada del stack; cloud y
# frontend no publican puertos propios).
APP_PORT=80

# Origen(es) permitidos por CORS para pegarle directo al backend (dev con
# "npm run dev" en el frontend, sin pasar por nginx).
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173
