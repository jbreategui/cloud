# Copiar a .env y ajustar valores reales. .env no se commitea (ver .gitignore).
SPRING_PROFILES_ACTIVE=prod

# Credenciales de Postgres: ya NO se configuran aqui. cloud las obtiene en runtime
# desde AWS Secrets Manager (secreto "sm_posgress", region us-east-2 - ver
# app.secrets.* en application.properties) usando el IAM Role de esta EC2, que
# debe tener permiso secretsmanager:GetSecretValue solo sobre ese secreto.

# cloud publica el puerto 8080 en la EC2; el Target Group del ALB
# (https://api.thaki.site) apunta ahi y hace health check a GET /api/server.

# Origen(es) permitidos por CORS, separados por coma. El frontend se sirve desde
# CloudFront en https://thaki.site y llama a https://api.thaki.site.
APP_CORS_ALLOWED_ORIGINS=https://thaki.site

# Identifica esta instancia en la respuesta de GET /api/server. Cada EC2 pone
# su propio valor en su .env local (no se versiona): EC2 #1 -> APP1,
# EC2 #2 -> APP2.
APP_SERVER_NAME=APP1
