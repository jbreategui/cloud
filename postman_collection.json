{
	"info": {
		"name": "Cloud API",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:8080"
		},
		{
			"key": "filename",
			"value": "reemplazar-con-el-campo-filename-devuelto-por-upload-o-list.jpg"
		}
	],
	"item": [
		{
			"name": "Hello",
			"request": {
				"method": "GET",
				"url": {
					"raw": "{{baseUrl}}/api/hello",
					"host": ["{{baseUrl}}"],
					"path": ["api", "hello"]
				}
			}
		},
		{
			"name": "Upload Image",
			"request": {
				"method": "POST",
				"url": {
					"raw": "{{baseUrl}}/api/images",
					"host": ["{{baseUrl}}"],
					"path": ["api", "images"]
				},
				"body": {
					"mode": "formdata",
					"formdata": [
						{
							"key": "file",
							"type": "file",
							"src": ""
						}
					]
				}
			}
		},
		{
			"name": "List Images",
			"request": {
				"method": "GET",
				"url": {
					"raw": "{{baseUrl}}/api/images",
					"host": ["{{baseUrl}}"],
					"path": ["api", "images"]
				}
			}
		},
		{
			"name": "Like Image",
			"request": {
				"method": "POST",
				"url": {
					"raw": "{{baseUrl}}/api/images/{{filename}}/like",
					"host": ["{{baseUrl}}"],
					"path": ["api", "images", "{{filename}}", "like"]
				}
			}
		}
	]
}
