# Copiar a .env (o .env.development.local) para "npm run dev". Vite solo expone
# variables con prefijo VITE_ y todas terminan en el bundle publico: nunca poner
# secretos aqui.
# En produccion ("npm run build") el valor sale de .env.production
# (https://api.thaki.site).
VITE_API_URL=http://localhost:8080
